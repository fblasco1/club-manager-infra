# Plantilla .env para producción (Hetzner CX23 + club-manager-infra)
# Copiar a .env en el servidor: cp docs/club/example.prod.env .env
# NO commitear .env con valores reales.

ERPNEXT_VERSION=v16.9.1

# Imagen custom con club_management (ajustar cuando exista registry/tag)
# CUSTOM_IMAGE=registry.example.com/icdpe/frappe-erpnext
# CUSTOM_TAG=mvp-secretaria-2026-06-16

DB_PASSWORD=CAMBIAR_PASSWORD_FUERTE

LETSENCRYPT_EMAIL=admin@icdpe.org.ar

# Dominio real del sitio Frappe (debe coincidir con bench new-site)
SITES_RULE=Host(`secretaria.icdpe.org.ar`)

# Si el nombre del sitio difiere del host HTTP
FRAPPE_SITE_NAME_HEADER=secretaria.icdpe.org.ar

# Opcional: puertos si no usás 80/443 por defecto
# HTTP_PUBLISH_PORT=80
# HTTPS_PUBLISH_PORT=443
